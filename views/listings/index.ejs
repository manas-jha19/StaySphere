<% layout("/layouts/boilerplate") %>
 <div class="filters-wrapper">
    <button class="scroll-btn left" onclick="scrollCategories(-200)">
    <i class="fa-solid fa-chevron-left"></i>
    </button>
    <div class="filters-container" id="filters">
        <a href="/listings" class="filter text-decoration-none text-dark">
           <div><i class="fa-solid fa-fire"></i></div>
           <p>Trending</p>
         </a>

        <a href="/listings?category=Rooms" class="filter text-decoration-none text-dark">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </a>
        <a href="/listings?category=Iconic Cities" class="filter text-decoration-none text-dark">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </a>
        <a href="/listings?category=Mountains" class="filter text-decoration-none text-dark">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </a>
        <a href="/listings?category=Castles" class="filter text-decoration-none text-dark">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </a>
        <a href="/listings?category=Amazing Pools" class="filter text-decoration-none text-dark">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pool</p>
        </a>
        <a href="/listings?category=Camping" class="filter text-decoration-none text-dark">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </a>
        <a href="/listings?category=Farms" class="filter text-decoration-none text-dark">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </a>
        <a href="/listings?category=Arctice" class="filter text-decoration-none text-dark">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctice</p>
        </a>
        </div>
          <button class="scroll-btn right" onclick="scrollCategories(200)">
    <i class="fa-solid fa-chevron-right"></i>
  </button>
   
       <div class="tax-toggle">
  <span class="me-2">Check price after taxes</span>
  <div class="form-check form-switch mb-0">
    <input class="form-check-input" type="checkbox" id="taxToggle" />
  </div>
</div>
</div>


      <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-1 row-cols-1 g-4">
     <% for(let list of storelistings){ %>
        <div class="col">
  <a class="showcard text-decoration-none text-dark" href="/listings/<%= list._id %>">
    <div class="card listing-card h-100">
  <img src="<%= list.image[0].url %>" class="card-img-top " alt="listing_image" />
  <div class="card-img-overlay"></div>
  
   <div class="card-body">
    <h6 class="card-title"><b><%= list.title %></b></h6>

    <div class="price-section">
        <span class="listingPrice" data-price="<%= list.price %>">
            ₹ <%= list.price.toLocaleString("en-IN") %> / Night
        </span>
    </div>
     </div>

    </div>
   </a>
        
     </div>
   <% } %>
</div>
  