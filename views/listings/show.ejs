<% layout("/layouts/boilerplate") %>
  <script>
    const MapToken = "<%= process.env.MAPBOX_TOKEN %>";
    const cordinates = <%- JSON.stringify( showall.geometry.coordinates) %>;
  </script>
  
    <div class="container show-page mt-4">
    <div class="col-heading col-10">
      <div class="listing-title">
        <%= showall.title %>
      </div>
    </div>
   <div class="image-gallery">

  <div class="main-image">
    <img src="<%= showall.image[0].url %>" />
      <button class=" mobile-view-all" onclick="openGallery()">
      View All Photos
    </button>
  </div>

  <div class="side-images">
    <% showall.image.slice(1,5).forEach((img,i)=>{ %>

      <div class="side-img-wrapper">
        <img src="<%= img.url %>">
        <% if(reqUser && reqUser._id.equals(showall.owner._id)){ %>
              <form action="/listings/<%= showall._id %>/images/<%= encodeURIComponent(img.filename) %>?_method=DELETE" method="POST">
                <button class="btn btn-dark">Delete</button>
              </form>
          <% } %>

        <% if(i === 3){ %>
        <button class="view-all-btn" onclick="openGallery()">View All</button>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>

<div id="galleryModal" class="gallery-modal">
  <span class="close-btn" onclick="closeGallery()">×</span>
  <div class="gallery-grid">
    <% showall.image.forEach(img=>{ %>
      <img src="<%= img.url %>" />
    <% }) %>
  </div>
</div>
      <div class="row mt-3">
        <div class="card-body col-lg-8 col-12 px-4">
          <p class="owner-text">
            <b>Owned by: </b><i>
              <%=showall.owner.username%>
            </i></p>
          <div>
            <%if(showall.propertyDetail.length>0){%>
  
             <p><b>Property details:</b></p>
         <ul>
       <% showall.propertyDetail.split(',').forEach(detail => { %>
       <li><%= detail.trim() %></li>
       <% }) %>
         </ul>
          <%}%>
         </div>
         <p><b>Description:</b>
            <%=showall.description%>
          </p>
         <p><b>location:</b>
            <%=showall.location%>
          </p>
          <p><b>country:</b>
            <%=showall.country%>
          </p>
         
        
    </div>

         <!-- RIGHT SIDE BOOKING CARD -->
    <div class="col-lg-4 col-12 mt-4 mt-lg-0">

      <div class="booking-card shadow-sm">

        <h4>₹ <%= showall.price.toLocaleString("en-IN") %> / night</h4>

        <% if(reqUser && reqUser.role === "user"){ %>

          <form method="POST" action="/listings/<%= showall._id %>/book">

            <input type="text" id="datePicker" class="form-control mb-2" placeholder="Select dates" required>

             <p class="mb-2 fw-bold">
                Total: ₹ <span id="totalAmount">0</span>
             </p>

            <input type="hidden" name="checkIn" id="checkIn">
            <input type="hidden" name="checkOut" id="checkOut">

            <button class="btn btn-primary w-100 mt-2">Reserve</button>

          </form>

        <% } else if(!reqUser){ %>

          <a href="/login" class="btn btn-outline-dark w-100 mt-2">Login to Book</a>

        <% } else { %>

          <p class="text-muted mt-2">Hosts cannot book their own property.</p>

        <% } %>

      </div>
    </div>
    </div>
          <% if(reqUser && reqUser._id.equals(showall.owner._id)){%>
      <div class="btns-edit-delete mt-3">
        <a href="/listings/<%=showall._id%>/edit" class="btn btn-dark editbtn">Edit</a>
        <form method="post" action="/listings/<%=showall._id%>?_method=DELETE">
          <button class="btn btn-dark">Delete</button>
        </form>
        
      </div>
      <br><br><br>
      <%}%>
</div>
        <hr>
        <div class="col-8 offset-2 mb-3">
          <%if(reqUser){%>
            <h3>Leave a Review</h3>
            <form method="post" action="/listings/<%=showall.id%>/reviews" class="mt-3 needs-validation" novalidate>
              <div>
                <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                    aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>
              <div class="mt-2">
                <label for="comment" class="form-label">Comment</label>
                <textarea name="review[comment]" id="comment" cols="5" placeholder="Write a comment"
                  class="form-control " required></textarea>
                <div class="invalid-feedback">Please leave a comment</div>
                <br>
                <button class="btn btn-outline-dark">Submit</button>
              </div>
            </form>
            <%}%>
            <br/>

              <% if(showall.reviews.length>0){%>

                <div class="row">
                  <hr>
                  <p><b>All Reviews</b></p>
                  <% for(review of showall.reviews){ %>
                    <div class="card col-5 ms-3 mb-1 card-review">
                      <div class="card-body">
                        <h6 class="card-title mt-1">@<%=review.author.username%>
                        </h6>
                        <p class="starability-result star-small card-text" data-rating="<%=review.rating%>"></p>
                        <p class="card-text mb-1">
                          <%=review.comment%>
                        </p>
                        <%if(review.author && reqUser && review.author._id.equals(reqUser._id)){%>
                          <form class="mb-2" method="post"
                            action="/listings/<%=showall._id%>/reviews/<%=review._id%>?_method=DELETE">
                            <button class="btn btn-sm btn-dark">Delete</button>
                          </form>
                          <%}%>
                      </div>
                    </div>
                    <%}%>
                </div>
                <% } %>
        </div>
        <div class="col-8 offset-2 mb-3">
          <h4>Where you'll be</h4>
          <div id="map"></div>
        </div>

  </div>
  <script src="/js/map.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
const pricePerNight = <%= showall.price %>;

flatpickr("#datePicker", {
    mode: "range",
    minDate: "today",
    onClose: function(selectedDates) {

        if (selectedDates.length === 2) {

            const checkIn = selectedDates[0];
            const checkOut = selectedDates[1];

            const nights = (checkOut - checkIn) / (1000 * 60 * 60 * 24);

            const total = nights * pricePerNight;

            document.getElementById("totalAmount").innerText = total.toLocaleString("en-IN");

            document.getElementById("checkIn").value = checkIn.toISOString();
            document.getElementById("checkOut").value = checkOut.toISOString();
        }
    }
});


</script>